# 偶宿 O! — 環境變數(複製成 .env.local 後填值)

# Supabase(開一個「新的」專案,不要用 ERP 那個)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 僅伺服器端使用(admin 操作、繞過 RLS);絕不加 NEXT_PUBLIC_ 前綴、絕不進前端
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 指定 admin email(逗號分隔);這些帳號登入後自動視為 admin
OUSU_ADMIN_EMAILS=you@example.com

# 站台網址(導流追蹤、分享卡用)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
