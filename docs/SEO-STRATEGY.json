  "core_principle": {
    "strategy": "不要單純養網域，要養網站的主題權威、品牌、資料庫與 Entity 關係",
    "priority": [
      "網站架構", "資料品質", "Entity 數量與完整度", "Internal Linking",
      "Technical SEO", "Structured Data", "高品質內容", "自然 Backlinks", "品牌搜尋"
